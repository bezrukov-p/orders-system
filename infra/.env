INVENTORY_SERVICE_HOST=inventory-service
NOTIFICATION_SERVICE_HOST=notification-service
DB_ORDER_HOST=postgres-order
DB_INVENTORY_HOST=postgres-inventory
DB_NOTIFICATION_HOST=postgres-notification

