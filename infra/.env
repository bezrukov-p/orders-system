# =============================================
# Порты микросервисов
# =============================================
ORDER_SERVICE_PORT=8080
INVENTORY_SERVICE_PORT=8081
NOTIFICATION_SERVICE_PORT=8082

# =============================================
# Порты инфраструктуры
# =============================================
DB_ORDER_PORT=5432
DB_INVENTORY_PORT=5433
DB_NOTIFICATION_PORT=5434

KAFKA_PORT=9092

# =============================================
# LGTM стек (Grafana + Loki + jaeger + Prometheus)
# =============================================
